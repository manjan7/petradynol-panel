#!/usr/bin/env bash
# Minimal Petradynol panel server for GitHub Actions.
# Serves a /health endpoint and a small status page on PANEL_PORT (default 3000).
PORT="${PANEL_PORT:-3000}"
exec python3 - "$PORT" <<'PY'
import http.server
import socketserver
import sys

port = int(sys.argv[1])

class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/health":
            body = b"ok\n"
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        else:
            body = ("<h1>Petradynol Panel</h1>"
                    "<p>Status: running</p>"
                    "<p>Port: %d</p>" % port).encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    def log_message(self, *args):
        pass

with socketserver.TCPServer(("", port), Handler) as httpd:
    httpd.allow_reuse_address = True
    httpd.serve_forever()
PY